{
  "name": "system-design-interactive",
  "private": true,
  "description": "Interactive system design simulator: build architectures, run traffic, see what breaks.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @sdi/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "bench": "pnpm --filter @sdi/engine bench",
    "sim": "pnpm --filter @sdi/cli sim"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  }
}
